# --- Alibaba Cloud Model Studio (DashScope) ---
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Firecrawl Cloud API ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2

# --- Local OWASP ZAP Daemon ---
ZAP_API_KEY=changeme
ZAP_API_URL=http://127.0.0.1:18080
ZAP_DOCKER_API_URL=http://zap:8080

# --- Target Configuration ---
TARGET_URL=http://localhost/
# Optional: If you expose localhost via Cloudflare Tunnel or Ngrok for Firecrawl Cloud:
# PUBLIC_TUNNEL_URL=https://your-tunnel-name.trycloudflare.com
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
MAX_ITERATIONS=5
MAX_REQUEST_BUDGET=1500
