{
  "target": {
    "base_url": "http://localhost:3000/",
    "seed_urls": [],
    "allowed_hosts": [
      "localhost",
      "127.0.0.1",
      "host.docker.internal"
    ]
  },
  "auth": {
    "enabled": true,
    "login": {
      "url": "http://localhost:3000/rest/user/login",
      "method": "POST",
      "json": {
        "email": "${AUTH_USER}",
        "password": "${AUTH_PASSWORD}"
      },
      "token_path": "authentication.token",
      "token_var": "AUTH_TOKEN"
    },
    "headers": {
      "Authorization": "Bearer ${AUTH_TOKEN}"
    },
    "cookies": {
      "token": "${AUTH_TOKEN}"
    },
    "browser_login": {
      "enabled": true,
      "login_page_url": "http://localhost:3000/#/login",
      "username": "${AUTH_USER}",
      "password": "${AUTH_PASSWORD}",
      "login_page_wait_sec": 5,
      "browser_id": "firefox-headless",
      "context_name": "dast-orchestrator",
      "user_name": "crawler"
    }
  },
  "orchestrator": {
    "max_iterations": 30,
    "parallel": true,
    "stages": [
      [
        "zap_traditional_spider",
        "zap_client_spider",
        "wapiti_form_crawl"
      ],
      [
        "firecrawl_navigate"
      ]
    ],
    "rules": {
      "browser_spider": "zap_client_spider",
      "max_retries": 1,
      "max_runs_per_tool": 10,
      "disabled_rules": [],
      "spa_html_page_max": 3
    }
  },
  "normalization": {
    "host_aliases": [
      "localhost",
      "127.0.0.1",
      "host.docker.internal"
    ],
    "path_rules": [],
    "query_aliases": {},
    "trailing_slash_dirs": [],
    "junk_substrings": []
  },
  "tools": {
    "zap": {
      "enabled": true,
      "api_url": "http://127.0.0.1:18080",
      "api_key": "changeme",
      "target_host_alias": "host.docker.internal",
      "spider": {
        "max_depth": 5,
        "max_duration_min": 0,
        "thread_count": 5,
        "parse_sitemap_xml": true,
        "parse_robots_txt": true,
        "process_form": true,
        "post_form": false
      },
      "ajax_spider": {
        "browser_id": "firefox-headless",
        "number_of_browsers": 2,
        "max_crawl_depth": 5,
        "max_crawl_states": 0,
        "max_duration_min": 0,
        "event_wait_ms": 1000,
        "reload_wait_ms": 1000,
        "click_default_elems": true,
        "click_elems_once": true,
        "random_inputs": true,
        "max_seeds": null
      },
      "client_spider": {
        "browser_id": "firefox-headless",
        "number_of_browsers": 2,
        "max_depth": 0,
        "max_children": 0,
        "max_duration_min": 0,
        "initial_load_time_sec": 0,
        "page_load_time_sec": 0,
        "action_wait_time_sec": 0,
        "shutdown_time_sec": 5,
        "scope_check": "Flexible",
        "logout_avoidance": true,
        "max_seeds": null,
        "per_seed_max_duration_min": null
      },
      "client_map_export": {
        "container_dir": "/zap/wrk",
        "host_dir": "output/zap",
        "file_name": "client_map.yaml"
      }
    },
    "wapiti": {
      "enabled": true,
      "binary": "wapiti",
      "scope": "domain",
      "max_parameters": 100,
      "max_scan_time": null,
      "timeout": 20,
      "depth": 40,
      "max_links_per_page": 100,
      "headless": "hidden",
      "wait_sec": 2,
      "cookie_file": null,
      "session_file": "output/temp/wapiti/session.db",
      "report_file": "output/temp/wapiti/report.json",
      "log_file": "output/logs/wapiti.log"
    },
    "firecrawl": {
      "enabled": true,
      "api_url": "https://api.firecrawl.dev/v2",
      "model": "spark-2",
      "auth_instructions": "Before exploring, open the login page (/#/login) and sign in with email ${AUTH_USER} and password ${AUTH_PASSWORD}. Stay logged in for the whole session and never click logout.",
      "fallback_routes_file": null,
      "poll_timeout_seconds": 600,
      "poll_interval_seconds": 10,
      "prompt_template": "configs/prompts/firecrawl_agent.md",
      "context_file": "configs/contexts/juice-shop.md",
      "prompts_dir": "output/prompts",
      "known_routes_max_chars": 4000,
      "batch_size": 10,
      "max_seeds": null,
      "max_credits": null,
      "effort": null
    },
    "http_probe": {
      "enabled": true,
      "timeout_sec": 10,
      "max_workers": 8
    }
  },
  "storage": {
    "sqlite_db": "storage/orchestrator_state.db"
  },
  "ground_truth": {
    "file_path": "ground_truth/avideo_routes.json"
  },
  "logging": {
    "log_level": "INFO",
    "log_file": "output/logs/orchestrator.log",
    "run_events_file": "output/logs/run_events.jsonl"
  }
}
